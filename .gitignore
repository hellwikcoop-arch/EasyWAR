# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build outputs
node_modules/
dist/
dist-standalone/
build/
target/
src-tauri/gen/
DerivedData/
*.app
*.dmg
*.msi
*.exe

# Local runtime data
data/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Operational/user data — never commit
*.xlsx
*.xls
# Empty base tables shipped with the app (structure only, see script/make_base_tables.py)
!src-tauri/resources/base-tables/*.xlsx
# Synthetic spreadsheets for tests (invented names and numbers, see script/make-artillery-fixture.py)
!tests/fixtures/*.xlsx
*.csv
*.kml
*.kmz
*.geojson

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Signal
signal-cli-data/
.signal-cli/

# Logs / temporary
*.log
*.tmp
*.bak
app_lite.html

# Codex coordination runtime state
.codex/coordination/*
!.codex/coordination/project.yaml

# Python bytecode from script/*.py
__pycache__/
*.pyc

# Language-model runner (runner/): CMake build trees and the sidecar built for the installer
runner/build/
src-tauri/binaries/easywar-llm-runner-*
