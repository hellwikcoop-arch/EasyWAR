{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyFLY",
  "version": "0.1.0",
  "identifier": "com.hellwikcoop.easyfly",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:easyfly-phone",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm --prefix ../.. run build:easyfly-phone",
    "frontendDist": "../../dist-easyfly-phone"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyFLY",
        "width": 430,
        "height": 932
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
