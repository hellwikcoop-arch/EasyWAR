{
  "name": "easywar-desktop",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:macos:adhoc": "tauri build --debug --config src-tauri/tauri.adhoc.conf.json && script/verify_macos_bundle.sh",
    "build:windows:technical": "powershell -NoProfile -ExecutionPolicy Bypass -File script/build_windows_installer.ps1 -Configuration Debug",
    "build:windows:production": "powershell -NoProfile -ExecutionPolicy Bypass -File script/build_windows_installer.ps1 -Configuration Release -RequireProductionSignature",
    "test:unit": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "jszip": "^3.10.2",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "vite": "^8.3.0"
  }
}
