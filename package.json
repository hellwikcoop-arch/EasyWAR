{
  "name": "easywar-desktop",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "node script/build_standalone.mjs",
    "build:app": "vite build && node script/build_standalone.mjs --out dist/standalone",
    "build:macos:adhoc": "tauri build --debug --config src-tauri/tauri.adhoc.conf.json && script/verify_macos_bundle.sh",
    "build:windows:technical": "powershell -NoProfile -ExecutionPolicy Bypass -File script/build_windows_installer.ps1 -Configuration Debug",
    "build:windows:production": "powershell -NoProfile -ExecutionPolicy Bypass -File script/build_windows_installer.ps1 -Configuration Release -RequireProductionSignature",
    "test:unit": "node --test tests/*.test.mjs",
    "audit:prod": "node script/npm_audit_gate.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "jszip": "^3.10.2",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "vite": "^8.3.4"
  }
}
