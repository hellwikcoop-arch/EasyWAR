+//! Ukrainian interface for EasySlide: egui passes every interface string through [`translate`]
+//! (hook `egui::l10n`). Whole strings are looked up in `EXACT`; strings built with `format!` match
+//! a `PATTERNS` entry, where `{}` stands for any text that is translated in turn. The tables are
+//! generated from `script/easyslide/uk.tsv` in EasyWAR.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+include!("uk_table.rs");
+
+thread_local! {
+    static INDEX: HashMap<&'static str, &'static str> = EXACT.iter().copied().collect();
+    static CACHE: RefCell<HashMap<String, Option<String>>> = RefCell::new(HashMap::new());
+}
+
+/// Cached results stay below this size: dynamic strings (zoom, counters) would grow it forever.
+const CACHE_LIMIT: usize = 20_000;
+
+pub fn translate(text: &str) -> Option<String> {
+    if let Some(hit) = CACHE.with_borrow(|c| c.get(text).cloned()) {
+        return hit;
+    }
+    let found = lookup(text, 0);
+    CACHE.with_borrow_mut(|c| {
+        if c.len() >= CACHE_LIMIT {
+            c.clear();
+        }
+        c.insert(text.to_owned(), found.clone());
+    });
+    found
+}
+
+fn lookup(text: &str, depth: u8) -> Option<String> {
+    if let Some(uk) = INDEX.with(|i| i.get(text).copied()) {
+        return Some(uk.to_owned());
+    }
+    // Keep the edge spaces and the trailing ellipsis or colon of a known string.
+    let trimmed = text.trim();
+    if trimmed.len() != text.len() && !trimmed.is_empty() {
+        let at = text.find(trimmed).unwrap_or(0);
+        let uk = lookup(trimmed, depth)?;
+        return Some(format!("{}{uk}{}", &text[..at], &text[at + trimmed.len()..]));
+    }
+    if depth > 2 {
+        return None;
+    }
+    PATTERNS.iter().find_map(|(en, uk)| {
+        let parts = capture(en, text)?;
+        let parts: Vec<String> = parts.into_iter().map(|p| lookup(p, depth + 1).unwrap_or_else(|| p.to_owned())).collect();
+        Some(fill(uk, &parts))
+    })
+}
+
+/// The texts standing for each `{}` of `pattern` in `text`, shortest first; `None` if it does not match.
+fn capture<'a>(pattern: &str, text: &'a str) -> Option<Vec<&'a str>> {
+    let pieces: Vec<&str> = pattern.split("{}").collect();
+    let (first, rest) = pieces.split_first()?;
+    let mut tail = text.strip_prefix(first)?;
+    let mut out = Vec::new();
+    for (i, piece) in rest.iter().enumerate() {
+        let last = i + 1 == rest.len();
+        let at = if last {
+            if !tail.ends_with(piece) || tail.len() < piece.len() {
+                return None;
+            }
+            tail.len() - piece.len()
+        } else if piece.is_empty() {
+            return None;
+        } else {
+            tail.find(piece)?
+        };
+        if at == 0 {
+            return None;
+        }
+        out.push(&tail[..at]);
+        tail = &tail[at + piece.len()..];
+    }
+    Some(out)
+}
+
+/// `{}` takes the captures in order; `{1}`, `{2}`… take them by number.
+fn fill(template: &str, parts: &[String]) -> String {
+    let mut out = String::with_capacity(template.len() + 16);
+    let mut next = 0;
+    let mut rest = template;
+    while let Some(open) = rest.find('{') {
+        out.push_str(&rest[..open]);
+        let after = &rest[open + 1..];
+        let Some(close) = after.find('}') else {
+            out.push_str(&rest[open..]);
+            return out;
+        };
+        let inner = &after[..close];
+        let index = if inner.is_empty() {
+            next += 1;
+            Some(next - 1)
+        } else {
+            inner.parse::<usize>().ok().and_then(|n| n.checked_sub(1))
+        };
+        match index.and_then(|i| parts.get(i)) {
+            Some(p) => out.push_str(p),
+            None => out.push_str(&rest[open..open + close + 2]),
+        }
+        rest = &after[close + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn patterns_and_fill() {
+        assert_eq!(capture("Slide {} of {}", "Slide 3 of 12"), Some(vec!["3", "12"]));
+        assert_eq!(capture("Slide {} of {}", "Slides 3 of 12"), None);
+        assert_eq!(capture("{}…", "Open…"), Some(vec!["Open"]));
+        assert_eq!(fill("{2} — {1}", &["a".into(), "b".into()]), "b — a");
+        assert_eq!(fill("{} з {}", &["3".into(), "12".into()]), "3 з 12");
+    }
+
+    #[test]
+    fn table_is_consistent() {
+        for (en, uk) in EXACT {
+            assert!(!en.contains("{}"), "{en}");
+            assert!(!uk.is_empty(), "{en}");
+        }
+        for (en, uk) in PATTERNS {
+            let holes = en.matches("{}").count();
+            assert!(holes > 0, "{en}");
+            for n in 1..=holes {
+                assert!(uk.contains("{}") || uk.contains(&format!("{{{n}}}")), "{en} → {uk}");
+            }
+        }
+    }
+}
