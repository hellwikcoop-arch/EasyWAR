+/// `window.easyslideHost` when the embedding page (EasyWAR) provides one.
+fn easyslide_host() -> Option<wasm_bindgen::JsValue> {
+    let window = web_sys::window()?;
+    let host = js_sys::Reflect::get(&window, &"easyslideHost".into()).ok()?;
+    (host.is_object()).then_some(host)
+}
+
+fn host_method(host: &wasm_bindgen::JsValue, name: &str) -> Result<js_sys::Function, String> {
+    js_sys::Reflect::get(host, &name.into())
+        .ok()
+        .and_then(|f| f.dyn_into::<js_sys::Function>().ok())
+        .ok_or_else(|| format!("easyslideHost.{name} is missing"))
+}
+
+/// `easyslideHost.open(purpose)` → `{ name, bytes: Uint8Array }` or `null` when cancelled.
+async fn host_open(host: &wasm_bindgen::JsValue, purpose: &str) -> Result<Option<(String, Vec<u8>)>, String> {
+    let js = |e: wasm_bindgen::JsValue| format!("{e:?}");
+    let promise = host_method(host, "open")?.call1(host, &purpose.into()).map_err(js)?;
+    let value = wasm_bindgen_futures::JsFuture::from(js_sys::Promise::resolve(&promise)).await.map_err(js)?;
+    if value.is_null() || value.is_undefined() {
+        return Ok(None);
+    }
+    let name = js_sys::Reflect::get(&value, &"name".into()).ok().and_then(|v| v.as_string()).unwrap_or_else(|| "presentation".into());
+    let bytes = js_sys::Reflect::get(&value, &"bytes".into()).map_err(js)?;
+    Ok(Some((name, js_sys::Uint8Array::new(&bytes).to_vec())))
+}
+
+/// Saves through `easyslideHost.save(name, bytes)` when hosted by EasyWAR, else a browser download.
+fn save_or_download(path: &str, bytes: &[u8]) -> Result<(), String> {
+    let Some(host) = easyslide_host() else { return download(path, bytes) };
+    let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "presentation".into());
+    let save = host_method(&host, "save")?;
+    save.call2(&host, &name.into(), &js_sys::Uint8Array::from(bytes)).map_err(|e| format!("{e:?}"))?;
+    Ok(())
+}
+
 fn push_inbox(inbox: &Inbox, event: InboxEvent) {
     inbox.lock().unwrap_or_else(|e| e.into_inner()).push(event);
 }
