+++ src/l10n.rs
@@ -0,0 +1,23 @@
+//! Interface translation hook (EasySlide): the application sets a translator once, and egui passes
+//! every label, button, tooltip and painter text through it just before layout. Text being edited
+//! (`TextEdit`) is laid out directly and never passes through here.
+
+use std::sync::OnceLock;
+
+/// Returns the translation of a whole interface string, or `None` to keep it.
+pub type Translator = fn(&str) -> Option<String>;
+
+static TRANSLATOR: OnceLock<Translator> = OnceLock::new();
+
+/// Sets the translator; only the first call has effect.
+pub fn set_translator(translator: Translator) {
+    let _ = TRANSLATOR.set(translator);
+}
+
+/// The text as the interface shows it: for measuring text that is painted through the hook.
+pub fn tr(text: String) -> String {
+    match TRANSLATOR.get() {
+        Some(translate) if !text.is_empty() => translate(&text).unwrap_or(text),
+        _ => text,
+    }
+}
