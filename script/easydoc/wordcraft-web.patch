diff -ruN a/apps/wordcraft-web/src/easywar_host.rs b/apps/wordcraft-web/src/easywar_host.rs
--- a/apps/wordcraft-web/src/easywar_host.rs
+++ b/apps/wordcraft-web/src/easywar_host.rs
@@ -0,0 +1,83 @@
+//! EasyDoc (EasyWAR) host bridge. When the page that loads this build defines
+//! `window.__easydocHost` with `openDocument()` and `saveDocument(name, bytes)` (both return
+//! promises), Open and Save go through the host application instead of the browser picker and
+//! download. Without the host object the browser behaviour is unchanged.
+
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wordcraft_ui_egui::Inbox;
+use wordcraft_ui_egui::async_saves::{AsyncSaves, SaveOutcome};
+
+/// Largest document accepted from the host (same cap as the browser picker path).
+const MAX_HOST_BYTES: usize = 256 << 20;
+
+fn host() -> Option<JsValue> {
+    let window = web_sys::window()?;
+    let host = js_sys::Reflect::get(&window, &JsValue::from_str("__easydocHost")).ok()?;
+    (host.is_object()).then_some(host)
+}
+
+fn method(host: &JsValue, name: &str) -> Option<js_sys::Function> {
+    js_sys::Reflect::get(host, &JsValue::from_str(name)).ok()?.dyn_into::<js_sys::Function>().ok()
+}
+
+/// Ask the host for a document; its bytes arrive through the inbox. `false` when there is no host
+/// (the caller falls back to the browser picker).
+pub fn open(inbox: Inbox, ctx: egui::Context) -> bool {
+    let Some(host) = host() else { return false };
+    let Some(open) = method(&host, "openDocument") else { return false };
+    let promise = match open.call0(&host) {
+        Ok(p) => js_sys::Promise::resolve(&p),
+        Err(e) => {
+            log::error!("easydoc host: openDocument failed: {e:?}");
+            return true;
+        }
+    };
+    wasm_bindgen_futures::spawn_local(async move {
+        let picked = match wasm_bindgen_futures::JsFuture::from(promise).await {
+            Ok(v) => v,
+            Err(e) => {
+                log::error!("easydoc host: openDocument rejected: {e:?}");
+                return;
+            }
+        };
+        if picked.is_null() || picked.is_undefined() {
+            return;
+        }
+        let name = js_sys::Reflect::get(&picked, &JsValue::from_str("name")).ok().and_then(|v| v.as_string()).unwrap_or_else(|| "document.docx".into());
+        let Ok(bytes) = js_sys::Reflect::get(&picked, &JsValue::from_str("bytes")) else { return };
+        let bytes = js_sys::Uint8Array::new(&bytes);
+        if bytes.length() as usize > MAX_HOST_BYTES {
+            log::warn!("easydoc host: document larger than 256 MB; not opened");
+            return;
+        }
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes.to_vec()));
+        ctx.request_repaint();
+    });
+    true
+}
+
+/// Hand a saved or exported file to the host. `None` when there is no host.
+pub fn save(saves: &AsyncSaves, ctx: &egui::Context, name: &str, bytes: &[u8]) -> Option<Result<(), String>> {
+    let host = host()?;
+    let save = method(&host, "saveDocument")?;
+    let array = js_sys::Uint8Array::from(bytes);
+    let promise = match save.call2(&host, &JsValue::from_str(name), &array) {
+        Ok(p) => js_sys::Promise::resolve(&p),
+        Err(e) => return Some(Err(format!("{e:?}"))),
+    };
+    let saves = saves.clone();
+    let ctx = ctx.clone();
+    let ticket = saves.start();
+    wasm_bindgen_futures::spawn_local(async move {
+        let outcome = match wasm_bindgen_futures::JsFuture::from(promise).await {
+            // The host resolves with the saved path, or null when the user cancelled.
+            Ok(v) if v.is_null() || v.is_undefined() => SaveOutcome::Cancelled,
+            Ok(_) => SaveOutcome::Saved,
+            Err(e) => SaveOutcome::Failed(e.as_string().unwrap_or_else(|| format!("{e:?}"))),
+        };
+        saves.finish(ticket, outcome);
+        ctx.request_repaint();
+    });
+    Some(Ok(()))
+}
